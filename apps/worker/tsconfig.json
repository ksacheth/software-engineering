{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "paths": {
      "@wvs/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@wvs/database": [
        "../../packages/database/src/index.ts"
      ],
      "@wvs/detectors": [
        "../../packages/detectors/src/index.ts"
      ],
      "@wvs/scope-guard": [
        "../../packages/scope-guard/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
