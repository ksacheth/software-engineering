flowchart TD
    %% Level 2 DFD - F.5 Vulnerability Detection
    %% External entities appear only in the Level 0 context diagram
    %% (Rajib Mall, Ch. 6); boundary arrows carry cross-boundary flows.

    I_From["From 0.4 Discovery"]
    I_To["To 0.6 Findings Management"]
    I_ScopeGuard["To 0.8 Scope Guard"]

    P51(("0.5.1 Run passive response checks"))
    P52(("0.5.2 Prepare safe active checks"))
    P53(("0.5.3 Enrich component versions"))

    D5@{ shape: datastore, label: "D5 Findings, Triage & Evidence" }
    B_Target[" "]
    B_OSV[" "]

    I_From -->|"discovered pages"| P51
    P51 -->|"passive evidence"| P52
    P52 -->|"active evidence"| P53
    P53 -->|"enriched findings"| I_To

    P52 -->|"safe-test candidate"| I_ScopeGuard
    I_ScopeGuard -->|"approved request"| B_Target
    B_Target -->|"approved response"| I_ScopeGuard
    I_ScopeGuard -->|"approved response / refusal"| P52
    P53 -->|"advisory query"| B_OSV
    B_OSV -->|"advisory result"| P53
    P53 --> D5

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    classDef iface fill:#e5e7eb,stroke:#4b5563,stroke-width:1px,stroke-dasharray: 5 5,color:#1f2937;
    classDef boundary fill:transparent,stroke:transparent,color:transparent;
    class P51,P52,P53 process;
    class D5 store;
    class I_From,I_To,I_ScopeGuard iface;
    class B_Target,B_OSV boundary;
