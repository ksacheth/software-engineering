flowchart TD
    %% Level 2 DFD - F.8 Safety, Auditing and Administration

    I_From["From 0.2 / 0.4 / 0.5"]
    Admin["System Administrator"]
    Target["Target Website"]
    DNS["Public DNS"]

    P81(("0.8.1 Check verification, scope and blocklist"))
    P82(("0.8.2 Re-resolve IP, rate-limit and apply ceiling"))
    P83(("0.8.3 Dispatch approved request or suppress"))

    D2@{ shape: datastore, label: "D2 Targets & Scope" }
    D6@{ shape: datastore, label: "D6 Append-only Audit Log / URL Ledger" }

    I_From -->|"request candidate"| P81
    P81 -->|"verification / scope decision"| P82
    P82 -->|"dispatch-ready request"| P83
    P83 -->|"approved request"| Target

    Admin -->|"quota, blocklist and kill-switch control"| P81
    D2 --> P81
    P82 -->|"fresh resolution query"| DNS
    DNS -->|"resolved IP"| P82
    P83 --> D6

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    classDef iface fill:#e5e7eb,stroke:#4b5563,stroke-width:1px,stroke-dasharray: 5 5,color:#1f2937;
    class P81,P82,P83 process;
    class Admin,Target,DNS entity;
    class D2,D6 store;
    class I_From iface;
