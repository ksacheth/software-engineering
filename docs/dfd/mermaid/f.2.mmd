flowchart TD
    %% Level 2 DFD - F.2 Target Management & Authorisation
    %% External entities appear only in the Level 0 context diagram
    %% (Rajib Mall, Ch. 6); boundary arrows carry cross-boundary flows.

    B_User[" "]
    P21(("0.2.1 Register target & scope boundaries"))
    P22(("0.2.2 Issue verification token"))
    P23(("0.2.3 Validate DNS TXT / well-known proof"))
    D2@{ shape: datastore, label: "D2 Targets & Scope" }
    B_DNS[" "]
    B_Target[" "]

    B_User -->|"target / scope request"| P21
    P23 -->|"verification decision / refusal"| B_User
    P21 -->|"registered target / scope"| P22
    P22 -->|"verification token / publication instructions"| B_User
    P22 -->|"verification token context"| P23
    P21 --> D2
    P23 --> D2
    P23 -->|"DNS TXT query"| B_DNS
    B_DNS -->|"TXT record"| P23
    P23 -->|"well-known token query"| B_Target
    B_Target -->|"verification response"| P23

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    classDef boundary fill:transparent,stroke:transparent,color:transparent;
    class P21,P22,P23 process;
    class D2 store;
    class B_User,B_DNS,B_Target boundary;
