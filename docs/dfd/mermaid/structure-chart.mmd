flowchart TD
    %% Level 1 Structure Chart - Website Vulnerability Scanner

    Root["MainScannerController"]

    M1["0.1 AccountAccessModule"]
    M2["0.2 TargetManagementModule"]
    M3["0.3 ScanConfigModule"]
    M4["0.4 DiscoveryEngineModule"]
    M5["0.5 VulnerabilityDetectionModule"]
    M6["0.6 FindingsManagementModule"]
    M7["0.7 ReportingExportModule"]
    M8["0.8 SafetyAuditingModule"]

    D1@{ shape: datastore, label: "D1 Accounts DB" }
    D2@{ shape: datastore, label: "D2 Targets DB" }
    D3@{ shape: datastore, label: "D3 Jobs DB" }
    D4@{ shape: datastore, label: "D4 Scan Records" }
    D5@{ shape: datastore, label: "D5 Findings DB" }
    D6@{ shape: datastore, label: "D6 Audit Ledger" }
    OSV["OSV / EPSS APIs"]
    SMTP["SMTP Service"]

    Root --> M1
    Root --> M2
    Root --> M3
    Root --> M4
    Root --> M5
    Root --> M6
    Root --> M7
    Root --> M8

    M1 --> D1
    M2 --> D2
    M3 --> D3
    M4 --> D4
    M5 --> D5
    M5 --> OSV
    M6 --> D5
    M7 --> SMTP
    M8 --> D6

    %% Styling
    classDef root fill:#312e81,stroke:#1e1b4b,stroke-width:2px,color:#ffffff;
    classDef module fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    classDef external fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;

    class Root root;
    class M1,M2,M3,M4,M5,M6,M7,M8 module;
    class D1,D2,D3,D4,D5,D6 store;
    class OSV,SMTP external;
