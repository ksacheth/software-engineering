%% Structure Chart — Website Vulnerability Scanner
%% Derived from the Level-1 and Level-2 DFDs using Rajib Mall's structured
%% design method (Fundamentals of Software Engineering, SA/SD):
%%   1. Transaction analysis at the top level — the user submits dissimilar
%%      transaction types, so the request router is a transaction centre with
%%      one action module per transaction path.
%%   2. Transform analysis for the scan pipeline — afferent branch (0.3/0.4)
%%      refines the job into the most abstract input "attack surface"; the
%%      transform centre (0.5) produces "raw findings"; the efferent branch
%%      (0.6) classifies them into "classified findings".
%%   3. The Safety Scope Guard (0.8) is factored as common (library) modules
%%      invoked from both the afferent and transform branches.
%% Notation: rectangle = module, solid arrow = module call; the data couples
%% are labelled with the verbatim flow names of the DFDs / data dictionary
%% and point in the direction the data travels (parameters down, results up);
%% dotted arrow = control couple (flag); double-edged box = library module.
%%{init: {'flowchart': {'nodeSpacing': 50, 'rankSpacing': 80, 'padding': 18}}}%%
flowchart TD
    %% ---------------- Top module and transaction centre ----------------
    MAIN["WVS Main Controller"]
    INP["Obtain User Request"]
    ROUTE["Analyse Request Type (Transaction Centre)"]

    MAIN -->|"request"| INP
    INP -->|"request"| ROUTE

    %% ---------------- Transaction branches (first-level factoring) ----------------
    T1["Handle Authentication (0.1)"]
    T2["Handle Target Management (0.2)"]
    T3["Handle Scan Launch & Execution (0.3)"]
    T4["Handle Findings Review (0.6)"]
    T5["Handle Report Export (0.7)"]
    T6["Handle Admin Safety Control (0.8)"]

    %% Each dispatch is paired with the result couple flowing back up
    ROUTE -->|"credentials"| T1
    T1 -->|"session / authorisation decision"| ROUTE
    ROUTE -->|"target / scope request"| T2
    T2 -->|"verification decision / refusal"| ROUTE
    ROUTE -->|"scan request"| T3
    %% Invisible helper pushes this return label out of the busy corridor
    T3 -->|"scan status"| R_SC[" "]:::boundary
    R_SC --> ROUTE
    ROUTE -->|"triage action / filters"| T4
    T4 -->|"finding views"| ROUTE
    ROUTE -->|"report options"| T5
    T5 -->|"exported report"| ROUTE
    ROUTE -->|"admin controls"| T6

    %% ---------------- 0.1 Authentication branch ----------------
    %% (invisible subgraphs keep each branch's children grouped & ordered)
    subgraph AuthChildren[" "]
        A11["Validate Credentials & MFA (0.1.1)"]
        A12["Issue Session Token & Verify Email (0.1.2)"]
        A13["Audit Login & Enforce Lockout (0.1.3)"]
    end
    T1 -->|"credentials"| A11
    T1 -->|"verification request"| A12
    T1 -->|"verified identity"| A13
    A13 -.->|"lockout flag"| T1

    %% ---------------- 0.2 Target management branch ----------------
    subgraph TargetChildren[" "]
        A21["Register Target & Scope (0.2.1)"]
        A22["Issue Verification Token (0.2.2)"]
        A23["Validate DNS TXT / Well-known Proof (0.2.3)"]
    end
    T2 -->|"target / scope request"| A21
    T2 -->|"registered target / scope"| A22
    T2 -->|"verification token context"| A23
    A23 -.->|"verification decision / refusal"| T2

    %% ---------------- 0.3 Scan branch: setup chain ----------------
    T3 -->|"scan request"| A31["Validate Profile, Limits & Quota (0.3.1)"]
    A31 -->|"validated profile"| A32["Queue Scan / Schedule (0.3.2)"]
    A32 -->|"job"| A33["Execute Scan Lifecycle & Checkpoint (0.3.3)"]

    %% ---------------- Transform analysis of the scan pipeline ----------------
    subgraph Afferent ["Afferent branch (incoming flow)"]
        AFF["Discover Attack Surface"]
        A41["Load Scope & Crawl Ceilings (0.4.1)"]
        A42["Discover Links, Forms, robots & Sitemap (0.4.2)"]
        A43["Render JS, Deduplicate & Record Limits (0.4.3)"]
    end

    subgraph TransformCentre ["Transform centre"]
        TRC["Detect Vulnerabilities"]
        A51["Run Passive Response Checks (0.5.1)"]
        A52["Prepare Safe Active Checks (0.5.2)"]
        A53["Enrich Component Versions (0.5.3)"]
    end

    subgraph Efferent ["Efferent branch (outgoing flow)"]
        EFF["Classify & Manage Findings"]
        A61["Normalise, Redact & Deduplicate (0.6.1)"]
        A62["Compare Prior Scan & Retain Evidence (0.6.2)"]
        A63["Apply Triage, Filtering & Sorting (0.6.3)"]
    end

    A33 -->|"scan job"| AFF
    AFF -->|"surface"| TRC
    TRC -->|"raw findings"| EFF

    %% Second-level factoring: each DFD bubble becomes a module
    AFF -->|"scan job"| A41
    AFF -->|"scope / ceilings"| A42
    AFF -->|"discovered resources"| A43

    TRC -->|"discovered pages"| A51
    TRC -->|"passive evidence"| A52
    TRC -->|"active evidence"| A53

    EFF -->|"raw findings"| A61
    EFF -->|"normalised findings"| A62
    EFF -->|"comparison result"| A63

    %% ---------------- Common (library) modules: 0.8 Safety Scope Guard ----------------
    subgraph SafetyLibrary ["Common safety modules — Scope Guard (0.8)"]
        SG1[["Check Verification, Scope & Blocklist (0.8.1)"]]
        SG2[["Re-resolve IP, Rate-limit & Apply Ceiling (0.8.2)"]]
        SG3[["Dispatch Approved Request & Record Audit Trail (0.8.3)"]]
    end

    A42 -->|"crawl candidate"| SG1
    A52 -->|"safe-test candidate"| SG1
    SG1 -->|"verification / scope decision"| SG2
    SG2 -->|"dispatch-ready request"| SG3
    SG3 -.->|"approved response / refusal"| A42
    SG3 -.->|"approved response / refusal"| A52
    T6 -.->|"quota, blocklist and kill-switch control"| SG1

    %% ---------------- 0.7 Report branch ----------------
    subgraph ReportChildren[" "]
        A71["Select Completed Scan & Options (0.7.1)"]
        A72["Assemble Template, Filters & Limitations (0.7.2)"]
        A73["Generate Export, Share Link & Notify (0.7.3)"]
    end
    T5 -->|"report options"| A71
    T5 -->|"selected scan"| A72
    T5 -->|"report content"| A73

    %% ---------------- Shared module call: findings review ----------------
    T4 -->|"triage action / filters"| A63

    %% ---------------- Legend ----------------
    subgraph Legend ["Legend"]
        LG1["Module"]
        LG2[["Library module (shared)"]]
        LG3["Receiving module"]
        LG1 -->|"call — data couple (direction of data)"| LG3
        LG1 -.->|"control couple"| LG3
        LG1 -->|"call"| LG2
    end

    %% ---------------- Styling ----------------
    classDef top fill:#1e1b4b,stroke:#0f172a,stroke-width:2px,color:#ffffff;
    classDef txcentre fill:#312e81,stroke:#1e1b4b,stroke-width:2px,color:#ffffff;
    classDef branch fill:#c7d2fe,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef leaf fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef lib fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#431407;
    classDef legend fill:#f3f4f6,stroke:#374151,stroke-width:1px,color:#111827;
    classDef boundary fill:transparent,stroke:transparent,color:transparent;

    class MAIN top;
    class ROUTE txcentre;
    class INP,T1,T2,T3,T4,T5,T6,AFF,TRC,EFF branch;
    class A11,A12,A13,A21,A22,A23,A31,A32,A33,A41,A42,A43,A51,A52,A53,A61,A62,A63,A71,A72,A73 leaf;
    class SG1,SG2,SG3 lib;
    class LG1,LG2,LG3 legend;

    style Afferent fill:#f8fafc,stroke:#64748b,stroke-width:1px,stroke-dasharray:6 4,color:#334155;
    style TransformCentre fill:#eef2ff,stroke:#4338ca,stroke-width:1px,stroke-dasharray:6 4,color:#312e81;
    style Efferent fill:#f8fafc,stroke:#64748b,stroke-width:1px,stroke-dasharray:6 4,color:#334155;
    style SafetyLibrary fill:#fffbeb,stroke:#b45309,stroke-width:1px,stroke-dasharray:6 4,color:#78350f;
    style Legend fill:transparent,stroke:#9ca3af,stroke-width:1px,stroke-dasharray:4 4,color:#4b5563;
    style AuthChildren fill:transparent,stroke:transparent,stroke-width:0px,color:transparent;
    style TargetChildren fill:transparent,stroke:transparent,stroke-width:0px,color:transparent;
    style ReportChildren fill:transparent,stroke:transparent,stroke-width:0px,color:transparent;
