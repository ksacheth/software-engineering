flowchart TD
    %% Level 2 DFD - F.4 Discovery (Crawling)
    %% External entities appear only in the Level 0 context diagram
    %% (Rajib Mall, Ch. 6); boundary arrows carry cross-boundary flows.

    I_From["From 0.3 Scan Execution"]
    I_To["To 0.5 Detection"]
    I_ScopeGuard["To 0.8 Scope Guard"]

    P41(("0.4.1 Load scope and crawl ceilings"))
    P42(("0.4.2 Discover links, forms, robots and sitemap"))
    P43(("0.4.3 Render JS, deduplicate and record limits"))

    D2@{ shape: datastore, label: "D2 Targets & Scope" }
    D4@{ shape: datastore, label: "D4 Scan Records" }
    B_Target[" "]

    I_From -->|"scan job"| P41
    P41 -->|"scope / ceilings"| P42
    P42 -->|"discovered resources"| P43
    P43 -->|"crawl evidence"| I_To

    D2 --> P41
    P42 -->|"crawl candidate"| I_ScopeGuard
    I_ScopeGuard -->|"approved request"| B_Target
    B_Target -->|"HTTP response / page content"| P43
    P43 --> D4

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    classDef iface fill:#e5e7eb,stroke:#4b5563,stroke-width:1px,stroke-dasharray: 5 5,color:#1f2937;
    classDef boundary fill:transparent,stroke:transparent,color:transparent;
    class P41,P42,P43 process;
    class D2,D4 store;
    class I_From,I_To,I_ScopeGuard iface;
    class B_Target boundary;
