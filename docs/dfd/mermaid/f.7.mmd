flowchart TD
    %% Level 2 DFD - F.7 Reporting and Export

    User["WVS User"]
    SMTP["SMTP Relay"]

    P71(("0.7.1 Select completed scan and report options"))
    P72(("0.7.2 Assemble template, filters and limitations"))
    P73(("0.7.3 Generate export and share link"))

    D4@{ shape: datastore, label: "D4 Scan Records" }
    D5@{ shape: datastore, label: "D5 Findings, Triage & Evidence" }

    User -->|"report options"| P71
    P71 -->|"selected scan"| P72
    P72 -->|"report content"| P73
    P73 -->|"exported report"| User

    D4 --> P71
    D5 --> P72
    P73 -->|"completion notification"| SMTP

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    class P71,P72,P73 process;
    class User,SMTP entity;
    class D4,D5 store;
