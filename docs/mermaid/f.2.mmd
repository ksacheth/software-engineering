flowchart TD
    %% Level 2 DFD - F.2 Target Management & Authorisation

    User["WVS User"]
    P21(("2.1 Register target & scope boundaries"))
    P22(("2.2 Issue verification token"))
    P23(("2.3 Validate DNS TXT / well-known proof"))
    D2@{ shape: datastore, label: "D2 Targets & Scope" }
    DNS["Public DNS"]
    Target["Target Website"]

    User -->|"target / scope request"| P21
    P23 -->|"verification decision / refusal"| User
    P21 -->|"registered target / scope"| P22
    P22 -->|"verification token / publication instructions"| User
    P22 -->|"verification token context"| P23
    P21 --> D2
    P23 --> D2
    P23 <-->|"DNS TXT query / TXT record"| DNS
    P23 <-->|"well-known token query / response"| Target

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    classDef store fill:transparent,stroke:#111827,stroke-width:2px,color:#111827;
    class P21,P22,P23 process;
    class User,DNS,Target entity;
    class D2 store;
