flowchart TD
    %% Level 2 DFD - F.1 User Authentication & Access Control

    User["WVS User"]
    P11(("1.1 Validate credentials & MFA"))
    P12(("1.2 Issue session token & verify email"))
    P13(("1.3 Audit login & enforce lockout"))
    D1[("D1 Accounts, Organisations & Sessions")]
    SMTP["SMTP Relay"]

    User -->|"credentials"| P11
    P11 -->|"session / access decision"| User
    P11 -->|"verification request"| P12
    P12 -->|"verified identity"| P13
    P11 -->|"account and failed attempts"| D1
    P12 <-->|"verification message / delivery outcome"| SMTP

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    classDef store fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    class P11,P12,P13 process;
    class User,SMTP entity;
    class D1 store;
