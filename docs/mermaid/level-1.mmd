flowchart TD
    %% Level 1 DFD - Top-Level Functional Decomposition

    subgraph External_Entities ["External Entities"]
        User["WVS User"]
        Admin["System Administrator"]
        Target["Target Website"]
        DNS["Public DNS Resolvers"]
        SMTP["SMTP Relay"]
        OSV["OSV / EPSS Advisory APIs"]
    end

    subgraph Processes ["Core Functional Modules"]
        P01(("0.1 Account & Access Management"))
        P02(("0.2 Target Management & Authorisation"))
        P03(("0.3 Scan Configuration & Execution"))
        P04(("0.4 Discovery (Crawling)"))
        P05(("0.5 Vulnerability Detection"))
        P06(("0.6 Findings Management"))
        P07(("0.7 Reporting & Export"))
        P08(("0.8 Safety, Auditing & Administration"))
    end

    %% Sequential Main Pipeline Flow
    User -->|"request"| P01
    P01 -->|"session / authorisation decision"| User
    P01 -->|"session"| P02
    P02 -->|"scope"| P03
    P03 -->|"job"| P04
    P04 -->|"surface"| P05
    P05 -->|"raw findings"| P06
    P06 -->|"classified findings"| P07
    P07 -->|"reports"| User

    %% Scope Guard and Safety Control Routing
    P04 -->|"crawl candidate"| P08
    P05 -->|"safe-test candidate"| P08
    Admin -->|"admin controls"| P08
    P08 -->|"approved traffic"| Target

    %% Third-Party External Interactions
    P02 -->|"DNS TXT verification query"| DNS
    DNS -->|"DNS TXT verification result"| P02
    P01 -->|"verification email"| SMTP
    SMTP -->|"delivery status"| P01
    P05 -->|"component advisory query"| OSV
    OSV -->|"component risk result"| P05

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    class P01,P02,P03,P04,P05,P06,P07,P08 process;
    class User,Admin,Target,DNS,SMTP,OSV entity;
