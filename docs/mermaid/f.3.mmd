flowchart TD
    %% Level 2 DFD - F.3 Scan Configuration and Execution

    User["WVS User"]
    P31(("3.1 Validate profile, limits and quota"))
    P32(("3.2 Queue scan or recurring schedule"))
    P33(("3.3 Execute lifecycle and checkpoint"))
    D2[("D2 Targets & Scope")]
    D3[("D3 Jobs & Checkpoints")]
    D4[("D4 Scan Records")]

    User -->|"scan request"| P31
    P33 -->|"scan status"| User
    P31 -->|"validated profile"| P32
    P32 -->|"queued job"| P33
    D2 -->|"verified target / scope"| P31
    P32 -->|"job / checkpoint"| D3
    P33 -->|"reproducibility record"| D4

    %% Styling
    classDef process fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#1e1b4b;
    classDef entity fill:#f3f4f6,stroke:#374151,stroke-width:2px,color:#111827;
    classDef store fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f;
    class P31,P32,P33 process;
    class User entity;
    class D2,D3,D4 store;
