datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// D1: Accounts, Organisations & Sessions (SRS F.1, DFD Level 2 1.3.1)
// Enforces SRS F.1: 1 user belongs to exactly 1 organization via Member(userId UNIQUE)
// User.role is the canonical authorization authority for NFR-SEC-2 object checks.
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  ANALYST
  DEVELOPER
  VIEWER
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             Role      @default(ANALYST)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)
  twoFactorEnabled Boolean?  @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  // Better Auth relations
  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitationsSent Invitation[] @relation("SentInvitations")
  twoFactors      TwoFactor[]

  // Domain relations
  createdTargets      Target[]               @relation("CreatedTargets")
  authorisedTargets   Target[]               @relation("AuthorisedTargets")
  createdSchedules    ScanSchedule[]         @relation("CreatedSchedules")
  triggeredScans      ScanJob[]              @relation("TriggeredScans")
  updatedTriages      TargetFindingTriage[]  @relation("UpdatedTriages")
  triageHistories     FindingTriageHistory[] @relation("UserTriageHistories")
  createdReports      ScanReport[]           @relation("CreatedReports")
  createdBlocklist    NetworkBlocklist[]     @relation("CreatedBlocklist")

  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime @db.Timestamptz(3)
  token                String   @unique
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Required for Better Auth organization plugin compatibility; mirrors Member.organizationId under 1:1
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  @@map("verification")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String?  @unique
  logo               String?
  metadata           String?
  maxConcurrentScans Int      @default(2)
  scanRateLimit      Int      @default(10)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  members       Member[]
  invitations   Invitation[]
  targets       Target[]
  scanSchedules ScanSchedule[]
  scanJobs      ScanJob[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique // SRS F.1: Strict 1:1 invariant - user belongs to exactly one organisation
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // Better Auth plugin wire format (User.role is canonical system authority)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId]) // Child side FK index for CASCADE deletes and org member listing
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?      @default("member") // Better Auth plugin wire format
  status         String       @default("pending")
  expiresAt      DateTime     @db.Timestamptz(3)
  inviterId      String
  inviter        User         @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
  @@index([inviterId])
  @@index([email])
  @@map("invitation")
}

// -----------------------------------------------------------------------------
// D2: Targets & Scope (SRS F.2, DFD Level 2 1.3.2)
// -----------------------------------------------------------------------------

enum VerificationMethod {
  DNS_TXT
  WELL_KNOWN
}

enum TargetVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum NetworkBlocklistType {
  CIDR
  HOST_SUFFIX
  IP_RANGE
  REGEX
}

model Target {
  id                    String                   @id @default(cuid())
  organizationId        String
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  origin                String
  label                 String
  verified              Boolean                  @default(false)
  verificationToken     String                   @unique // CSPRNG token generated in app code (SRS C.2)
  verificationMethod    VerificationMethod       @default(DNS_TXT)
  verificationStatus    TargetVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?                @db.Timestamptz(3)
  verificationExpiresAt DateTime?                @db.Timestamptz(3)
  authorisationAck      Boolean                  @default(false)
  authorisationAckAt    DateTime?                @db.Timestamptz(3)
  authorisationAckById  String?
  authorisationAckUser  User?                    @relation("AuthorisedTargets", fields: [authorisationAckById], references: [id], onDelete: SetNull)
  verifiedIpRanges      String[]                 @default([])
  includedPaths         String[]                 @default([])
  excludedPaths         String[]                 @default([])
  maxDepth              Int                      @default(5)
  maxPages              Int                      @default(200)
  maxRequests           Int                      @default(2000)
  rateLimit             Int                      @default(10)
  isArchived            Boolean                  @default(false)
  archivedAt            DateTime?                @db.Timestamptz(3)
  createdById           String?
  createdBy             User?                    @relation("CreatedTargets", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  scanSchedules   ScanSchedule[]
  scanJobs        ScanJob[]
  findings        Finding[]
  findingDiffs    ScanFindingDiff[]
  triageState     TargetFindingTriage[]
  triageHistories FindingTriageHistory[]

  @@unique([organizationId, origin]) // SRS F.2 / C.2: prevent duplicate targets with conflicting scope
  @@index([origin])
  @@index([createdById])
  @@index([authorisationAckById])
  @@map("target")
}

model NetworkBlocklist {
  id          String               @id @default(cuid())
  pattern     String
  patternType NetworkBlocklistType @default(HOST_SUFFIX)
  reason      String
  isActive    Boolean              @default(true)
  createdById String?
  createdBy   User?                @relation("CreatedBlocklist", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)

  @@index([pattern])
  @@index([createdById])
  @@map("network_blocklist")
}

// -----------------------------------------------------------------------------
// D3: Jobs & Checkpoints (SRS F.3, DFD Level 2 1.3.3)
// -----------------------------------------------------------------------------

enum ScanProfile {
  PASSIVE
  STANDARD
  THOROUGH
}

enum ScanStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  ABORTED_SAFETY
}

enum ScanPhase {
  DISCOVERY
  DETECTION
  REPORTING
  COMPLETED
}

enum CrawlLimitType {
  DEPTH_REACHED
  PAGE_CEILING_REACHED
  REQUEST_CEILING_REACHED
  QUEUE_EXHAUSTED
  CANCELLED
  TIMEOUT
  SAFETY_ABORT
}

model ScanSchedule {
  id             String       @id @default(cuid())
  targetId       String
  target         Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cronSchedule   String
  profile        ScanProfile  @default(STANDARD)
  isActive       Boolean      @default(true)
  nextRunAt      DateTime?    @db.Timestamptz(3)
  lastRunAt      DateTime?    @db.Timestamptz(3)
  rateLimit      Int          @default(10)
  concurrency    Int          @default(5)
  maxDepth       Int          @default(5)
  maxPages       Int          @default(200)
  maxRequests    Int          @default(2000)
  createdById    String?
  createdBy      User?        @relation("CreatedSchedules", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  scanJobs ScanJob[]

  @@index([targetId])
  @@index([organizationId])
  @@index([isActive, nextRunAt])
  @@index([createdById])
  @@map("scan_schedule")
}

model ScanJob {
  id                 String          @id @default(cuid())
  scheduleId         String?
  schedule           ScanSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  targetId           String
  target             Target          @relation(fields: [targetId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile            ScanProfile     @default(STANDARD)
  status             ScanStatus      @default(QUEUED)
  phase              ScanPhase       @default(DISCOVERY)
  workerId           String?
  rateLimit          Int             @default(10)
  concurrency        Int             @default(5)
  maxDepth           Int             @default(5)
  maxPages           Int             @default(200)
  maxRequests        Int             @default(2000)
  detectorVersions   Json?
  pagesCrawled       Int             @default(0)
  requestsMade       Int             @default(0)
  findingsCount      Int             @default(0)
  progressPercentage Float           @default(0.0)

  // Degradation & Blocking indicators (§3.2.3, F.4)
  isDegraded         Boolean         @default(false)
  degradations       Json            @default("[]")
  blockingDetected   Boolean         @default(false)
  blockingDetectedAt DateTime?       @db.Timestamptz(3)

  queuedAt           DateTime        @default(now()) @db.Timestamptz(3)
  startedAt          DateTime?       @db.Timestamptz(3)
  completedAt        DateTime?       @db.Timestamptz(3)
  pausedAt           DateTime?       @db.Timestamptz(3)
  cancelledAt        DateTime?       @db.Timestamptz(3)
  failureReason      String?
  bindingLimit       CrawlLimitType?
  createdById        String?
  createdBy          User?           @relation("TriggeredScans", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  checkpoint     ScanCheckpoint?
  crawledPages   CrawledPage[]
  findings       Finding[]
  findingDiffs   ScanFindingDiff[]
  detectorErrors DetectorExecutionError[]
  reports        ScanReport[]
  urlLedgers     UrlLedger[]

  @@index([targetId])
  @@index([organizationId, status]) // Concurrency quota checking (SRS F.3), covers organizationId prefix
  @@index([status])
  @@index([scheduleId])
  @@index([createdById])
  @@map("scan_job")
}

model ScanCheckpoint {
  id                 String    @id @default(cuid())
  scanJobId          String    @unique
  scanJob            ScanJob   @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  phase              ScanPhase
  crawlFrontier      Json
  crawledUrls        Json
  completedDetectors Json
  pendingDetectors   Json
  checkpointedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  metadata           Json?

  @@map("scan_checkpoint")
}

// -----------------------------------------------------------------------------
// D4: Scan Records (SRS F.4, DFD Level 2 1.3.4)
// -----------------------------------------------------------------------------

model CrawledPage {
  id                String   @id @default(cuid())
  scanJobId         String
  scanJob           ScanJob  @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  url               String
  normalizedUrl     String
  method            String   @default("GET")
  statusCode        Int
  contentType       String?
  depth             Int      @default(0)
  responseTimeMs    Int?
  requestHeaders    Json?
  responseHeaders   Json?
  forms             Json?
  parameters        Json?
  linksFound        Json?
  isBlocked         Boolean  @default(false)
  reducedConfidence Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scanJobId, normalizedUrl, method]) // SRS F.4 dedup & left-prefix index
  @@map("crawled_page")
}

// -----------------------------------------------------------------------------
// D5: Findings, Triage & Evidence (SRS F.5, F.6, DC-9, DFD Level 2 1.3.5, 1.3.6)
// -----------------------------------------------------------------------------

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingConfidence {
  CONFIRMED
  FIRM
  TENTATIVE
}

enum ComparisonStatus {
  NEW
  PERSISTING
  RESOLVED
}

enum TriageState {
  OPEN
  CONFIRMED
  FALSE_POSITIVE
  ACCEPTED_RISK
  RESOLVED
}

enum DetectorErrorType {
  TIMEOUT
  UNEXPECTED_RESPONSE
  PARSE_FAILURE
  TEMPLATE_ERROR
  INTERNAL
}

model Finding {
  id                String            @id @default(cuid())
  fingerprint       String
  scanJobId         String
  scanJob           ScanJob           @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  targetId          String
  target            Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  detectorId        String
  name              String
  description       String
  remediation       String
  severity          FindingSeverity
  confidence        FindingConfidence
  cwe               String?
  owaspCategory     String?
  affectedUrl       String
  affectedParameter String?
  cvssScore         Float?
  cvssVector        String?
  cveId             String?
  epssScore         Float?
  epssPercentile    Float?
  advisoryData      Json?
  occurrenceCount   Int               @default(1)
  occurrences       Json?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)

  evidence FindingEvidence?

  @@unique([scanJobId, fingerprint]) // SRS F.6: finding dedup within a scan & left-prefix index
  @@index([targetId, fingerprint, createdAt(sort: Desc)]) // Fast posture & RESOLVED lookups (covers targetId prefix)
  @@index([fingerprint])
  @@index([severity])
  @@map("finding")
}

// Diff table representing scan comparison without mutating past findings (SRS DC-9, F.6)
model ScanFindingDiff {
  id          String           @id @default(cuid())
  scanJobId   String
  scanJob     ScanJob          @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  targetId    String
  target      Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  fingerprint String
  status      ComparisonStatus // NEW, PERSISTING, RESOLVED
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([scanJobId, fingerprint])
  @@index([targetId, status])
  @@index([targetId, fingerprint])
  @@index([scanJobId, status])
  @@map("scan_finding_diff")
}

model FindingEvidence {
  id               String    @id @default(cuid())
  findingId        String    @unique
  finding          Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  requestHeaders   Json?
  requestBody      String?
  responseHeaders  Json?
  responseBody     String?
  curlCommand      String?
  extractedSnippet String?
  isRedacted       Boolean   @default(false) // F.6/C.7 compliance flag: asserted explicitly on sanitisation complete
  redactionVersion Int       @default(1)
  isPurged         Boolean   @default(false)
  purgedAt         DateTime? @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@index([expiresAt, isPurged])
  @@map("finding_evidence")
}

// Current triage projection: 1 row per (targetId, findingFingerprint) for O(1) reads (NFR-PERF-1)
// Managed entirely by sync_target_finding_triage database trigger
model TargetFindingTriage {
  targetId           String
  target             Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)
  findingFingerprint String
  state              TriageState           @default(OPEN)
  justification      String?
  updatedById        String?
  updatedBy          User?                 @relation("UpdatedTriages", fields: [updatedById], references: [id], onDelete: SetNull)
  lastHistoryId      String?
  lastHistory        FindingTriageHistory? @relation("ProjectedTriageHistory", fields: [lastHistoryId], references: [id], onDelete: Restrict)
  updatedAt          DateTime              @default(now()) @db.Timestamptz(3) // Trigger-managed server time

  @@id([targetId, findingFingerprint])
  @@index([targetId, state])
  @@index([updatedById])
  @@map("target_finding_triage")
}

// Append-only triage audit trail (SRS DC-9)
model FindingTriageHistory {
  id                 String      @id @default(cuid())
  findingFingerprint String
  targetId           String
  target             Target      @relation(fields: [targetId], references: [id], onDelete: Cascade)
  state              TriageState @default(OPEN)
  justification      String?
  userId             String?
  user               User?       @relation("UserTriageHistories", fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)

  projectedTriages TargetFindingTriage[] @relation("ProjectedTriageHistory")

  @@index([targetId, findingFingerprint, createdAt(sort: Desc)]) // Covers targetId prefix
  @@index([findingFingerprint])
  @@index([userId])
  @@map("finding_triage_history")
}

// Unbounded detector runtime failure records (SRS F.5, NFR-QUAL-1)
model DetectorExecutionError {
  id              String            @id @default(cuid())
  scanJobId       String
  scanJob         ScanJob           @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  detectorId      String
  url             String?
  parameter       String?
  errorType       DetectorErrorType
  message         String
  occurrenceCount Int               @default(1)
  occurredAt      DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([scanJobId, detectorId, errorType]) // Upsert target (covers scanJobId prefix)
  @@index([detectorId, errorType])
  @@map("detector_execution_error")
}

// -----------------------------------------------------------------------------
// D6: Append-only Audit Log / URL Ledger (SRS F.8, DC-9, DFD Level 2 1.3.8)
// -----------------------------------------------------------------------------

enum AuditAction {
  AUTH_REGISTER
  AUTH_LOGIN
  AUTH_LOGOUT
  AUTH_FAILED
  AUTH_LOCKOUT
  AUTH_MFA_ENABLED
  TARGET_CREATED
  TARGET_VERIFIED
  TARGET_ARCHIVED
  TARGET_DELETED
  SCAN_QUEUED
  SCAN_STARTED
  SCAN_PAUSED
  SCAN_RESUMED
  SCAN_CANCELLED
  SCAN_ABORTED_SAFETY
  FINDING_TRIAGED
  EVIDENCE_PURGED
  REPORT_EXPORTED
  ADMIN_KILL_SWITCH_ENGAGED
  ADMIN_KILL_SWITCH_DISENGAGED
  ADMIN_BLOCKLIST_CREATED
  ADMIN_BLOCKLIST_UPDATED
  ADMIN_BLOCKLIST_DELETED
  ADMIN_QUOTA_CHANGED
}

model AuditLog {
  id             String      @id @default(cuid())
  timestamp      DateTime    @default(now()) @db.Timestamptz(3)
  action         AuditAction
  organizationId String?
  userId         String?
  ipAddress      String?
  userAgent      String?
  resourceType   String?
  resourceId     String?
  metadata       Json?

  @@index([organizationId, timestamp])
  @@index([action])
  @@index([timestamp])
  @@map("audit_log")
}

enum ScopeDecision {
  ALLOWED
  BLOCKED_VERIFICATION
  BLOCKED_SCOPE
  BLOCKED_BLOCKLIST
  BLOCKED_RATE_LIMIT
  BLOCKED_CEILING
  BLOCKED_DNS_REBINDING
  BLOCKED_KILL_SWITCH
  ERROR
}

model UrlLedger {
  id             String        @id @default(cuid())
  scanJobId      String
  scanJob        ScanJob       @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  timestamp      DateTime      @default(now()) @db.Timestamptz(3)
  url            String
  resolvedIp     String
  httpMethod     String        @default("GET")
  statusCode     Int?
  decision       ScopeDecision
  decisionReason String?
  responseTimeMs Int?
  bytesSent      Int?
  bytesReceived  Int?

  @@index([scanJobId, timestamp])
  @@map("url_ledger")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_setting")
}

// -----------------------------------------------------------------------------
// F.7: Reporting & Export (SRS F.7, DFD Level 2 1.3.7)
// -----------------------------------------------------------------------------

enum ReportTemplate {
  EXECUTIVE_SUMMARY
  TECHNICAL_REPORT
}

enum ReportFormat {
  PDF
  HTML
  JSON
  CSV
  SARIF
}

model ScanReport {
  id                  String           @id @default(cuid())
  scanJobId           String
  scanJob             ScanJob          @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  template            ReportTemplate
  format              ReportFormat
  filePath            String?
  fileSize            Int?
  shareToken          String?          @unique
  shareExpiresAt      DateTime?        @db.Timestamptz(3)
  minSeverityFilter   FindingSeverity?
  triageStatusFilter  TriageState?
  coverageLimitations String
  createdById         String?
  createdBy           User?            @relation("CreatedReports", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([scanJobId])
  @@index([createdById])
  @@map("scan_report")
}
