{
  "name": "website-vulnerability-scanner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --env-file=.env --filter \"@wvs/*\" dev",
    "typecheck": "bun --filter \"@wvs/*\" typecheck",
    "test": "bun --filter \"@wvs/*\" test",
    "db:generate": "bun --filter @wvs/database generate",
    "db:push": "bun --env-file=.env --filter @wvs/database db:push",
    "db:migrate:dev": "bun --env-file=.env --filter @wvs/database migrate:dev",
    "db:migrate:deploy": "bun --env-file=.env --filter @wvs/database migrate:deploy",
    "db:studio": "bun --env-file=.env --filter @wvs/database studio",
    "email:retry": "bun --env-file=.env --filter @wvs/api email:retry",
    "scans:reconcile": "bun --env-file=.env --filter @wvs/api scans:reconcile",
    "purge:retention": "bun --env-file=.env --filter @wvs/database purge:retention",
    "reports:worker": "bun --env-file=.env --filter @wvs/api reports:worker",
    "scheduler": "bun --env-file=.env --filter @wvs/api scheduler",
    "admin:grant": "bun --env-file=.env --filter @wvs/api admin:grant"
  }
}
