# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wvs?schema=public"

# Redis (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
TOTP_ENCRYPTION_KEY=

# Scan Engine & Scope Guard
SCANNER_USER_AGENT="WebsiteVulnerabilityScanner/1.0 (+https://scanner.example.com/bot-info)"
SCANNER_DEFAULT_RATE_LIMIT=10
SCANNER_MAX_CONCURRENCY=5
SCANNER_CRAWL_TIMEOUT_MS=60000

# External APIs
OSV_API_BASE_URL="https://api.osv.dev/v1"
EPSS_API_BASE_URL="https://api.first.org/data/v1/epss"

# SMTP Relay (Mailpit / External SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@wvs.local"
SMTP_SECURE=false

# Storage & Retention
EVIDENCE_RETENTION_DAYS=90
REPORT_STORAGE_PATH="./storage/reports"
