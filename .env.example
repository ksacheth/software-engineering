# ==============================================================================
# Website Vulnerability Scanner (WVS) - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=development
PORT=4100
WEB_PORT=3000
WEB_ORIGIN="http://localhost:3000"
# Express `trust proxy`. nginx (deploy/nginx.conf) and the Vite dev proxy both
# run on loopback, so "loopback" is correct for dev and production. Use a hop
# count, an IP/CIDR, or "false" if you deploy behind something else.
TRUST_PROXY=loopback

# Database (PostgreSQL 16+)
# Runtime App Role (SRS DC-9: Least-privilege role with no UPDATE/DELETE/TRUNCATE on audit_log, url_ledger, finding_triage_history)
DATABASE_URL="postgresql://wvs_app:APP_PASSWORD_HERE@localhost:5432/wvs?schema=public"
# Migration/Owner Role (Used by directUrl for running DDL migrations and schema resets)
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wvs?schema=public"
# Runtime Application Role Password (provisioned during migrate/bootstrap; required in staging/production)
WVS_APP_PASSWORD="APP_PASSWORD_HERE"

# Redis (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis logical database index (0-15). The API, the queue and the scan event
# channel all use this one, so a shared Redis used by anything else should give
# WVS a dedicated index.
REDIS_DB=0

# Better Auth & Security (Generate with: openssl rand -base64 32)
# Required: the API refuses to start without BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4100"

# Two-Factor Authentication
TOTP_ENCRYPTION_KEY=

# Scan Engine & Scope Guard (SRS F.3, F.4, F.8)
SCANNER_USER_AGENT="WebsiteVulnerabilityScanner/1.0 (+https://scanner.example.com/bot-info)"
SCANNER_DEFAULT_RATE_LIMIT=10
SCANNER_MAX_CONCURRENCY=5
SCANNER_CRAWL_TIMEOUT_MS=60000
# How often the email outbox is drained in-process. 0 disables it; the drain
# belongs in apps/worker, and running it on every API instance would double-send.
EMAIL_RETRY_INTERVAL_MS=0

# Automated tests ONLY. `bun run test` points these at a scratch database and a
# scratch Redis index so a test run cannot truncate development data or delete
# jobs a running worker is holding.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wvs_test"
# TEST_REDIS_DB=15

# External Enrichment APIs (SRS F.5)
OSV_API_BASE_URL="https://api.osv.dev/v1"
EPSS_API_BASE_URL="https://api.first.org/data/v1/epss"

# SMTP Relay (Mailpit / External SMTP, SRS F.1)
# `docker compose up -d` starts Mailpit; read delivered mail at http://localhost:8025
# Mailpit is a local sink: it captures messages and forwards none, so nothing
# reaches a real inbox while these defaults are in place.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@wvs.local"
SMTP_SECURE=false

# To deliver to real inboxes, replace the six SMTP_* values above and restart
# the API. No code change is needed: apps/api/src/lib/email.ts speaks plain SMTP.
# Keep SMTP_PORT and SMTP_SECURE consistent (465 implies true, 587/1025 imply
# false), and set SMTP_FROM to an address the relay has authorised.
#
# Resend (needs a domain you control, verified with SPF/DKIM records)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_your_api_key
#   SMTP_FROM="WVS <noreply@yourdomain.com>"
#
# Gmail (needs 2FA plus an App Password from myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   SMTP_FROM=you@gmail.com
#
# SendGrid (Single Sender Verification authorises one address, no domain needed)
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.your_api_key
#   SMTP_FROM=you@example.com

# Email outbox retry (SRS F.1 §3.2.3: failed messages are queued for retry)
# 0 disables the in-process drain, which is the default on purpose: the drain
# belongs in apps/worker, and running it in the API would send duplicates once
# more than one API instance is running (NFR-SCAL-1). Drain on demand instead:
#   bun run email:retry
# Set a millisecond interval only for a single-instance deployment.
EMAIL_RETRY_INTERVAL_MS=0

# Storage & Retention (SRS F.6, DC-9)
EVIDENCE_RETENTION_DAYS=90
REPORT_STORAGE_PATH="./storage/reports"
